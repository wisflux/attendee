# ── Attendee environment template ──────────────────────────────────────────
# Copy this file to .env and fill in the values. The real .env is gitignored.
#
#   cp .env.example .env
#
# The two secret keys below can be auto-generated with the bundled script:
#   docker compose -f dev.docker-compose.yaml run --rm attendee-app-local python init_env.py
# (or `python init_env.py` if running outside Docker), then paste its output here.

# ── Secrets (REQUIRED — generate your own; never reuse someone else's) ───────
# Fernet key used to encrypt stored provider credentials (Zoom, Deepgram, etc.).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Django secret key (session/CSRF signing).
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# ── Object storage for recordings ───────────────────────────────────────────
# For local development the bundled MinIO service (dev.docker-compose.yaml)
# works with the defaults below. For production, point these at your real
# S3 bucket and credentials and remove the *_ENDPOINT_URL overrides.
AWS_RECORDING_STORAGE_BUCKET_NAME=attendee-recordings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://minio:9000
AWS_S3_ENDPOINT_URL=http://localhost:9000
